# URL pubblica del sito, senza slash finale
NEXT_PUBLIC_SITE_URL=

# Adapter server-side. Valori ammessi: demo, supabase. Default: demo.
CATALOG_REPOSITORY=
AUTH_SERVICE=

# Configurazione pubblica Supabase. In locale usare esclusivamente lo stack CLI.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo server: non usare mai in variabili NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=

# Integrazioni future, non attive in questa fase
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=
