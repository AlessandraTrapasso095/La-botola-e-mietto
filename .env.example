# URL pubblica del sito, senza slash finale
NEXT_PUBLIC_SITE_URL=

# Adapter server-side.
# In sviluppo/test: demo oppure supabase.
# In produzione: entrambi devono essere supabase.
CATALOG_REPOSITORY=
AUTH_SERVICE=

# Supabase DEV Hosted usato nello sviluppo quotidiano.
# Lo stack Supabase locale può essere avviato solo volontariamente per test isolati.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Solo server: non usare mai in variabili NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=
# Segreto server-side di almeno 32 caratteri per HMAC del rate limiting.
RATE_LIMIT_SECRET=

# Stripe server-side
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email server-side
EMAIL_PROVIDER=resend
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=La Botola e Mietto
