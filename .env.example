# Solo server: non usare mai in variabili NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=

# Integrazioni future, non attive in questa fase
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=
