# URL pubblica del sito, senza slash finale
NEXT_PUBLIC_SITE_URL=

# Adapter server-side. Valori ammessi: demo, supabase. Default: demo.
CATALOG_REPOSITORY=
AUTH_SERVICE=

# Supabase DEV Hosted usato nello sviluppo quotidiano.
# Lo stack Supabase locale può essere avviato solo volontariamente per test isolati.
NEXT_PUBLIC_SUPABASE_URL=
